"COMPLETED"},{"amount":43,"status":"DROPPED"},{"amount":39,"status":"PAUSED"}]},"status":"FINISHED","streamingEpisodes":[{"site":"Crunchyroll","thumbnail":"https://img1.ak.crunchyroll.com/i/spire2-tmb/ea06ba63802b1f5ef8e8cdeb376c4d6a1687895598_full.jpg","title":"-RYO-","url":"http://www.crunchyroll.com/watch/GX9UQZW85/-ryo-"}],"studios":[[3,"GONZO",false,true]],"synonyms":["Wakate Animator Ikusei Project","2012 Young Animator Training Project","Anime Mirai 2012"],"title":{"english":"RYO","native":"龍-RYO-","romaji":"RYO"},"trailer":null,"trending":0,"type":"ANIME","updatedAt":1793711197},"14349":{"al":14349,"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/14349-5pTzcH4MLf2g.jpg","coverImage":{"color":"#e4435d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx14349-zvSfbgjZr4LW.jpg"},"description":"For young witches everywhere, the world-renowned witch Shiny Chariot reigns as the most revered and celebrated role model. But as the girls age, so do their opinions of her—now just the mention of Chariot would get a witch labeled a child. However, undeterred in her blind admiration for Chariot, ordinary girl Atsuko Kagari enrolls into Luna Nova Magical Academy, hoping to someday become just as mesmerizing as her idol.<br>\n<br>\nHowever, the witch academy isn't all the fun and games Atsuko thought it would be: boring lectures, strict teachers, and students who mock Chariot plague the campus. Coupled with her own ineptness in magic, she's seen as little more than a rebel student. But when a chance finally presents itself to prove herself to her peers and teachers, she takes it, and now it's up to her to stop a rampaging dragon before it flattens the entire academy.<br>\n<br>\nLittle Witch Academia is one of the four anime works that each received 38 million yen (about US$480,000) from the \"2012 Young Animator Training Project.\" Just like in 2010 and 2011, the animation labor group received 214.5 million yen (US$2.65 million) from the Japanese government's Agency for Cultural Affairs, and it distributed most of those funds to studios who train young animators on-the-job.<br>\n<br>\nPositive response to the movie led Studio Trigger to run a Kickstarter funding a sequel, which surpassed its funding goal.\n","duration":26,"endDate":{"day":2,"month":3,"year":2013},"episodes":1,"externalLinks":[],"genres":["Comedy","Fantasy"],"hashtag":null,"isLicensed":true,"meanScore":76,"nextAiringEpisode":null,"rankings":[{"allTime":true,"context":"highest rated all time","format":"MOVIE","rank":281,"season":null,"type":"RATED","year":null},{"allTime":true,"context":"most popular all time","format":"MOVIE","rank":76,"season":null,"type":"POPULAR","year":null},{"allTime":false,"context":"highest rated","format":"MOVIE","rank":12,"season":null,"type":"RATED","year":2013},{"allTime":false,"context":"most popular","format":"MOVIE","rank":5,"season":null,"type":"POPULAR","year":2013}],"relations":[["SEQUEL",19489,19489,"ANIME","MOVIE"],["OTHER",14347,14347,"ANIME","MOVIE"],["OTHER",13863,13863,"ANIME","MOVIE"],["OTHER",14353,14353,"ANIME","MOVIE"],["ALTERNATIVE",21858,33489,"ANIME","TV"],["ADAPTATION",96203,93692,"MANGA","MANGA"],["ADAPTATION",96202,93691,"MANGA","MANGA"]],"season":"WINTER","seasonYear":2013,"source":"ORIGINAL","startDate":{"day":2,"month":3,"year":2013},"stats":{"scoreDistribution":[{"amount":134,"score":10},{"amount":70,"score":20},{"amount":215,"score":30},{"amount":474,"score":40},{"amount":1758,"score":50},{"amount":4011,"score":60},{"amount":11830,"score":70},{"amount":15592,"score":80},{"amount":9090,"score":90},{"amount":3749,"score":100}],"statusDistribution":[{"amount":2019,"status":"CURRENT"},{"amount":25126,"status":"PLANNING"},{"amount":73173,"status":"COMPLETED"},{"amount":1011,"status":"DROPPED"},{"amount":873,"status":"PAUSED"}]},"status":"FINISHED","streamingEpisodes":[],"studios":[[803,"TRIGGER",true,true]],"synonyms":["LWA","Wakate Animator Ikusei Project","2012 Young A