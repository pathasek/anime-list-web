ilistcdn/media/anime/cover/medium/19773.jpg"},"description":"The popular Manga \"The Three-Eyed Boy Comes Here\" was produced as the eighth in an animated series for a special 24-hour broadcast. This time, the movie was produced by Toei Animation Co., Ltd. instead of by Tezuka Productions Co., Ltd. Here, Tezuka Osamu was in charge of only the original story and a synopsis for animation. <br><br>\nBased on the original Manga, \"Easter Island: Sea voyage,\" Sharaku and Wato investigate a mysterious old ship, only to find themselves getting involved in a sea voyage around strange islands. More emphasis was placed on entertainment factors than on theme, and this change in the concept line resulted in the withdrawal of Tezuka Productions Co., Ltd. from this series.<br><br>\n(Source: tezukaosamu.net)","duration":79,"endDate":{"day":25,"month":8,"year":1985},"episodes":1,"externalLinks":[],"genres":["Adventure","Comedy","Supernatural"],"hashtag":null,"isLicensed":true,"meanScore":62,"nextAiringEpisode":null,"rankings":[],"relations":[["ALTERNATIVE",5249,5249,"ANIME","TV"],["ADAPTATION",40798,10798,"MANGA","MANGA"]],"season":"SUMMER","seasonYear":1985,"source":"MANGA","startDate":{"day":25,"month":8,"year":1985},"stats":{"scoreDistribution":[{"amount":11,"score":10},{"amount":1,"score":20},{"amount":18,"score":30},{"amount":9,"score":40},{"amount":21,"score":50},{"amount":23,"score":60},{"amount":20,"score":70},{"amount":14,"score":80},{"amount":30,"score":90},{"amount":13,"score":100}],"statusDistribution":[{"amount":14,"status":"CURRENT"},{"amount":178,"status":"PLANNING"},{"amount":222,"status":"COMPLETED"},{"amount":25,"status":"DROPPED"},{"amount":8,"status":"PAUSED"}]},"status":"FINISHED","streamingEpisodes":[],"studios":[[18,"Toei Animation",true,true],[6620,"Nippon Television Network",false,false]],"synonyms":[],"title":{"english":null,"native":"悪魔島のプリンス 三つ目がとおる","romaji":"Akuma Tou no Prince: Mitsume ga Tooru"},"trailer":null,"trending":0,"type":"ANIME","updatedAt"