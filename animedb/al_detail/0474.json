i/index.html"}],"genres":["Action","Comedy","Drama","Mystery"],"hashtag":"#緋色の弾丸 #緋色の不在証明 #コナンRELOAD","isLicensed":true,"meanScore":73,"nextAiringEpisode":null,"rankings":[{"allTime":false,"context":"highest rated","format":"MOVIE","rank":39,"season":null,"type":"RATED","year":2021},{"allTime":false,"context":"most popular","format":"MOVIE","rank":46,"season":null,"type":"POPULAR","year":2021}],"relations":[["SEQUEL",113653,39764,"ANIME","MOVIE"],["PARENT",235,235,"ANIME","TV"]],"season":"WINTER","seasonYear":2021,"source":"MANGA","startDate":{"day":11,"month":2,"year":2021},"stats":{"scoreDistribution":[{"amount":6,"score":10},{"amount":3,"score":20},{"amount":7,"score":30},{"amount":16,"score":40},{"amount":52,"score":50},{"amount":84,"score":60},{"amount":167,"score":70},{"amount":127,"score":80},{"amount":94,"score":90},{"amount":80,"score":100}],"statusDistribution":[{"amount":100,"status":"CURRENT"},{"amount":1105,"status":"PLANNING"},{"amount":1369,"status":"COMPLETED"},{"amount":45,"status":"DROPPED"},{"amount":34,"status":"PAUSED"}]},"status":"FINISHED","streamingEpisodes":[],"studios":[[73,"TMS Entertainment",true,true]],"synonyms":["Detective Conan: The Scarlet Alibi","Case Closed: The Scarlet Alibi","Detetive Conan: O Álibi Escarlate"],"title":{"english":null,"native":"名探偵コナン 緋色の不在証明","romaji":"Meitantei Conan: Hiiro no Fuzai Shoumei"},"trailer":{"id":"R0UX89w9y2s","site":"youtube"},"trending":0,"type":"ANIME","updatedAt":1793702964},"47425":{"al":132417,"bannerImage":null,"coverImage":{"color":"#e46b5d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx132417-cWInYykCOa26.jpg"},"description":"Kamen Rider Saber short released on the Toei Tokusatsu Fanclub (TTFC) app.","duration":6,"endDate":{"day":29,"month":8,"year":2021},"episodes":6,"externalLinks":[],"genres":[],"hashtag":null,"isLicensed":true,"meanScore":52,"nextAiringEpisode":null,"rankings":[],"relations":[["PARENT",130556,null,"MANGA","MANGA"]],"season":"WINTER","seas