; many tales simply star \"Me\" and \"Her.\" \n<br><br>\nStories include Emblem of My Father, Two in the Beer Garden, Old Hawaii Corner, My Brother's Zippo, and Takeru's Love of Two and a Half Millennia. The tobacco analogy may sound strange in these politically correct times, but it is better than the alternative, remembering that such short manga stories are actually designed to take no longer to read than the average dump.\n<br><br>\n(Source; Anime Encyclopedia)","duration":3,"endDate":{"day":26,"month":3,"year":1988},"episodes":78,"externalLinks":[],"genres":["Romance","Slice of Life"],"hashtag":null,"isLicensed":true,"meanScore":59,"nextAiringEpisode":null,"rankings":[],"relations":[["OTHER",119134,21121,"ANIME","OVA"],["OTHER",204544,57185,"ANIME","TV_SHORT"],["SOURCE",212866,null,"MANGA","MANGA"]],"season":null,"seasonYear":null,"source":"MANGA","startDate":{"day":3,"month":10,"year":1986},"stats":{"scoreDistribution":[{"amount":11,"score":10},{"amount":4,"score":20},{"amount":9,"score":30},{"amount":12,"score":40},{"amount":22,"score":50},{"amount":29,"score":60},{"amount":31,"score":70},{"amount":13,"score":80},{"amount":12,"score":90},{"amount":6,"score":100}],"statusDistribution":[{"amount":67,"status":"CURRENT"},{"amount":786,"status":"PLANNING"},{"amount":200,"status":"COMPLETED"},{"amount":51,"status":"DROPPED"},{"amount":42,"status":"PAUSED"}]},"status":"FINISHED","streamingEpisodes":[],"studios":[[7017,"Meruhensha",true,true]],"synonyms":[" Tobacco Ippon no Story: Heart Cocktail"],"title":{"english":null,"native":"ハートカクテル","romaji":"Heart Cocktail"},"trailer":null,"trending":0,"type":"ANIME","updatedAt":1793705996}}