led to meet with Oborozuki. She begs to release her from the agreement, but discovers how eager he is to take over her body.<br>\n<br>\n(Source: Official site, translated & edited)","duration":12,"endDate":{"day":26,"month":2,"year":2021},"episodes":1,"externalLinks":[],"genres":["Hentai"],"hashtag":null,"isLicensed":true,"meanScore":48,"nextAiringEpisode":null,"rankings":[],"relations":[["SEQUEL",186619,null,"ANIME","OVA"]],"season":"WINTER","seasonYear":2021,"source":"ORIGINAL","startDate":{"day":26,"month":2,"year":2021},"stats":{"scoreDistribution":[{"amount":17,"score":10},{"amount":19,"score":20},{"amount":23,"score":30},{"amount":24,"score":40},{"amount":45,"score":50},{"amount":32,"score":60},{"amount":20,"score":70},{"amount":15,"score":80},{"amount":8,"score":90},{"amount":8,"score":100}],"statusDistribution":[{"amount":96,"status":"CURRENT"},{"amount":378,"status":"PLANNING"},{"amount":292,"status":"COMPLETED"},{"amount":38,"status":"DROPPED"},{"amount":67,"status":"PAUSED"}]},"status":"FINISHED","streamingEpisodes":[],"studios":[[6943,"Poly Animation",true,true]],"synonyms":["Meijyou","Infatuation"],"title":{"english":null,"native":"迷情","romaji":"Meijou"},"trailer":null,"trending":1,"type":"ANIME","updatedAt":1793790111}}