 want more... I love you ♡</i><br>\n<br>\n(Source: Mediabank, translated)","duration":20,"endDate":{"day":null,"month":null,"year":null},"episodes":null,"externalLinks":[],"genres":["Hentai","Romance"],"hashtag":null,"isLicensed":true,"meanScore":66,"nextAiringEpisode":null,"rankings":[],"relations":[["SOURCE",167031,148674,"MANGA","MANGA"],["SOURCE",166566,null,"MANGA","ONE_SHOT"],["SOURCE",166567,null,"MANGA","ONE_SHOT"],["SOURCE",156291,157670,"MANGA","ONE_SHOT"],["SOURCE",161275,157669,"MANGA","ONE_SHOT"]],"season":"SPRING","seasonYear":2025,"source":"MANGA","startDate":{"day":6,"month":6,"year":2025},"stats":{"scoreDistribution":[{"amount":8,"score":10},{"amount":5,"score":20},{"amount":6,"score":30},{"amount":6,"score":40},{"amount":26,"score":50},{"amount":45,"score":60},{"amount":41,"score":70},{"amount":23,"score":80},{"amount":29,"score":90},{"amount":26,"score":100}],"statusDistribution":[{"amount":273,"status":"CURRENT"},{"amount":611,"status":"PLANNING"},{"amount":223,"status":"COMPLETED"},{"amount":39,"status":"DROPPED"},{"amount":129,"status":"PAUSED"}]},"status":"RELEASING","streamingEpisodes":[],"studios":[[6093,"Queen Bee",false,true],[6098,"Mediabank",false,false]],"synonyms":[],"title":{"english":null,"native":"黒ギャルアラカルト","romaji":"Kuro Gal A La Carte"},"trailer":null,"trending":0,"type":"ANIME","updatedAt":1793698649},"60983":{"al":186736,"bannerImage":null,"coverImage":{"color":"#e4bb5d","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx186736-zYDrRDuC55s5.png"},"description":"The second season of <i>Kagaku×Bouken Survival!</i>","duration":24,"endDate":{"day":14,"month":3,"year":2026},"episodes":19,"externalLinks":[{"language":"Japanese","site":"Official Site","type":"INFO","url":"https://www.toei-anim.co.jp/tv/survival/"},{"language":"Japanese","site":"Twitter","type":"SOCIAL","url":"https://twitter.com/kagakusurvival/"}],"genres":[],"hashtag":"#科学漫画サバイバル #サバイバルシリーズ","isLicensed":true,"meanScore":53,"nextAiringEpiso