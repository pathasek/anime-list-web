mount":3,"score":100}],"statusDistribution":[{"amount":3,"status":"CURRENT"},{"amount":43,"status":"PLANNING"},{"amount":142,"status":"COMPLETED"},{"amount":7,"status":"DROPPED"},{"amount":2,"status":"PAUSED"}]},"status":"FINISHED","streamingEpisodes":[],"studios":[],"synonyms":[],"title":{"english":null,"native":"Angry Rabbit","romaji":"Angry Rabbit"},"trailer":{"id":"W8IWHw15O_g","site":"youtube"},"trending":0,"type":"ANIME","updatedAt":1793696634},"64844":{"al":215791,"bannerImage":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/215791-oXrDQgpDqpmi.jpg","coverImage":{"color":"#861a6b","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx215791-HCSqMdni1ZxD.jpg"},"description":"Armageddon—the final war between good and evil, to be waged at the end of the world. Its predetermined outcome was overturned. The desperate wish of those who “did not want to die”—that hopeless selfishness—empowered the evil god. Eight billion humans were sacrificed, and only a handful were allowed to survive—to be toyed with endlessly as the evil god’s playthings. The “Frashokereti” (Renewal of the World), which had been repeated countless times since the dawn of the universe, was shattered here for the first time.<br><br>\n\nThe sun will never rise again.<br>\nIn a world where reason has gone mad, there is only one thing of value: human blood.<br>\nBlood is currency. Blood is fuel. Blood is—a weapon.<br><br>\n\nAfter countless sacrifices, the magicians devised a single spell. A forbidden ritual that transforms a girl’s blood into a blade capable of vanquishing demons.<br>\nBlood as a weapon. Life as a weapon. Humanity itself—the final weapon to resist the demons.<br>\nChosen… Survivors… The strongest, cursed girls.<br>\nBlood-battle humans—.<br><br>\n\nThe younger sister is the strongest blood-battle human, her soul stolen. The older sister was born unable to walk. Yet, she is the only one in this world—her blood alone can awaken the power of her slumbering sister.<br><br>\n\nEva and Epica. Sisters bound by fate in the darkness of the apocalypse.<br>\nWith their blood... strike down the demons that have defiled the world!<br><br>\n\nAn original dark fantasy action series by Seiji Kishi, Makoto Uezu, LAM, and Polygon Pictures is here!<br><br>\n(Source: YouTube Description, translated)","duration":null,"endDate":{"day":null,"month":null,"year":null},"episodes":null,"externalLinks":[{"language":"Japanese","site":"Twitter","type":"SOCIAL","url":"https://x.com/maidenblood_x"},{"language":"Japanese","site":"Official Site","type":"INFO","url":"https://maiden-blood.com/"}],"genres":["Action","Fantasy"],"hashtag":"#maidenblood #メイデンブラッド","isLicensed":true,"meanScore":null,"nextAiringEpisode":null,"rankings":[{"allTime":false,"context":"most popular","format":"TV","rank":88,"season":null,"type":"POPULAR","year":2027}],"relations":[],"season":null,"seasonYear":null,"source":"ORIGINAL","startDate":{"day":null,"month":null,"year":2027},"stats":{"scoreDistribution":[{"amount":1,"score":10},{"amount":1,"score":60},{"amount":1,"score":70},{"amount":3,"score":90},{"amount":3,"score":100}],"statusDistribution":[{"amount":32,"status":"CURRENT"},{"amount":1741,"status":"PLANNING"},{"amount":2,"status":"COMPLETED"},{"amount":5,"status":"DROPPED"},{"amount":7,"status":"PAUSED"}]},"status":"NOT_YET_RELEASED","streamingEpisodes":[],"studios":[[6067,"POLYGON PICTURES",true,true],[144,"Pony Canyon",false,false]],"synonyms":["メイデンブラッド"],"title":{"english":null,"native":"Maiden Blood","romaji":"Maiden Blood"},"trailer":{"id":"Z2SIqLntKGc","site":"youtube"},"trending":0,"type":"ANIME","updatedAt":1793709774},"64848":{"al":208367,"bannerImage":null,"coverImage":{"color":"#3578bb","extraLarge":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx208367-qWKRaOpokGoG.jpg"},"description":"Sequel to <i> Duel Masters LOST: Boukyaku no Taiyou</i>.","duration":24,"endDate":{"day":null,"month":null,"year":null},"episodes":4,"externalLinks":